# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Fig pre block. Keep at the top of this file.
[[ -f "$HOME/.fig/shell/zshrc.pre.zsh" ]] && builtin source "$HOME/.fig/shell/zshrc.pre.zsh"
# # Fig pre block. Keep at the top of this file.
# # shortcut to this dotfiles path is $DOTFILES
export DOTFILES=$HOME/.dotfiles

# ensure the correct locales are used
export LANG="nl_BE.UTF-8"
export LC_COLLATE="nl_BE.UTF-8"
export LC_CTYPE="nl_BE.UTF-8"
export LC_MESSAGES="nl_BE.UTF-8"
export LC_MONETARY="nl_BE.UTF-8"
export LC_NUMERIC="nl_BE.UTF-8"
export LC_TIME="nl_BE.UTF-8"

if [[ "${TERM_PROGRAM-}" == "iTerm.app" ]] && [[ -r "$HOME/Library/Application Support/iTerm2/DynamicProfiles/zenjoy.profile.plist" ]]; then
	echo -e "\033]50;SetProfile=Zenjoy\a"
	tput reset
fi

# Load Homebrew, path is depending on CPU architecture
set_homebrew_env() {
  local prefix="$1"
  local repository="$2"

  export HOMEBREW_PREFIX="$prefix"
  export HOMEBREW_CELLAR="$prefix/Cellar"
  export HOMEBREW_REPOSITORY="$repository"

  case ":$PATH:" in
    *":$prefix/bin:"*) ;;
    *) export PATH="$prefix/bin:$PATH" ;;
  esac

  case ":$PATH:" in
    *":$prefix/sbin:"*) ;;
    *) export PATH="$prefix/sbin:$PATH" ;;
  esac

  case ":${INFOPATH:-}:" in
    *":$prefix/share/info:"*) ;;
    *) export INFOPATH="$prefix/share/info:${INFOPATH:-}" ;;
  esac

  if [[ -n "${MANPATH-}" ]]; then
    export MANPATH=":${MANPATH#:}"
  fi
}

arch_name="$(uname -m)"
if [[ "${arch_name}" = "x86_64" ]]; then
  if [[ -f "/usr/local/bin/brew" ]]; then
    if [[ "$(sysctl -n -q sysctl.proc_translated)" = "1" ]]; then
      echo "Terminal Running on Rosetta 2"
    fi

    set_homebrew_env "/usr/local" "/usr/local/Homebrew"
  fi
elif [[ "${arch_name}" = "arm64" ]]; then
  if [[ -f "/opt/homebrew/bin/brew" ]]; then
    set_homebrew_env "/opt/homebrew" "/opt/homebrew"
  fi
elif [[ "${arch_name}" = "aarch64" ]]; then
  # Running on ARM-based linux, there is no Linuxbrew on ARM64
fi

# Load rbenv
# if [[ -d "$HOMEBREW_PREFIX/rbenv" ]]; then
#   export RBENV_ROOT="$HOMEBREW_PREFIX/rbenv"
#   export PATH="$RBENV_ROOT/bin:$RBENV_ROOT/shims:$PATH"
#   eval "$(rbenv init -)"
# fi

# if [[ -d "$HOME/.rbenv" ]]; then
#   export RBENV_ROOT="$HOME/.rbenv"
#   export PATH="$RBENV_ROOT/bin:$RBENV_ROOT/shims:$PATH"
#   eval "$(rbenv init -)"
# fi

if [[ -d "$HOME/.zcompcache" ]]
then
	export ZSH_CACHE_DIR=$HOME/.zcompcache
fi

if [[ -a "$DOTFILES/.multiuser" ]]
then
	# skip verification of insecure directories (to allow multiuser setups)
	export ZSH_DISABLE_COMPFIX="true"
fi

# macOS 12.3 deprecates python 2.7 and removed the command
if [[ -d "$HOMEBREW_PREFIX/opt/python@3.9/libexec/bin" ]]; then
  export PATH="$HOMEBREW_PREFIX/opt/python@3.9/libexec/bin:$PATH"
fi

# your project folder that we can `c [tab]` to
export PROJECTS=~/Development

if [[ -z "${ZSH_CACHE_DIR-}" ]]; then
  export ZSH_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/zsh"
fi
mkdir -p "$ZSH_CACHE_DIR"

source_dotfiles_file() {
  local file="$DOTFILES/$1"
  [[ -r "$file" ]] && source "$file"
}

# load keychain helpers early so .localrc can use them
source $DOTFILES/system/keys.zsh
source $DOTFILES/system/eval-cache.zsh
source_dotfiles_file script/dotfiles-env.sh
source_dotfiles_file script/dotfiles-shell-stack.sh

# use .localrc for SUPER SECRET CRAP that you don't
# want in your public, versioned repo.
if [[ -a ~/.localrc ]]; then
  source ~/.localrc
fi

if (( ${+functions[dotfiles_init_env]} )); then
  dotfiles_init_env
fi

source_dotfiles_file system/path.zsh
source_dotfiles_file zsh/fpath.zsh
source_dotfiles_file system/env.zsh
source_dotfiles_file zsh/config.zsh
source_dotfiles_file zsh/completion.zsh

autocomplete_plugin="$(dotfiles_zsh_autocomplete_plugin_path 2>/dev/null)"
if [[ -r "$autocomplete_plugin" ]]; then
  zstyle -e ':autocomplete:*:*' list-lines 'reply=( $(( LINES / 3 )) )'
  zstyle ':autocomplete:*' add-semicolon no
  source "$autocomplete_plugin"
  bindkey              '^I' menu-select
  bindkey "$terminfo[kcbt]" menu-select
  bindkey -M menuselect              '^I'         menu-complete
  bindkey -M menuselect "$terminfo[kcbt]" reverse-menu-complete
fi

defer_plugin="$DOTFILES/system/zsh-defer.plugin.zsh"
if [[ -r "$defer_plugin" ]]; then
  source "$defer_plugin"
fi

typeset -a repo_topic_files
repo_topic_files=(
  system/sdkman.zsh
  system/functions.zsh
  system/aliases.zsh
  git/aliases.zsh
  git/completion.zsh
  ruby/aliases.zsh
  ruby/functions.zsh
  ruby/completion.zsh
  k8s/aliases.zsh
  k8s/zcr.zsh
  k8s/kubectl.plugin.zsh
  k8s/helm.plugin.zsh
  osx/functions.zsh
  osx/enable-touchid-sudo.zsh
  xcode/aliases.zsh
  zsh/aliases.zsh
  zsh/window.zsh
)

for file in $repo_topic_files; do
  source_dotfiles_file "$file"
done

# ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE="20"
# ZSH_AUTOSUGGEST_USE_ASYNC=1
autosuggestions_plugin="$DOTFILES_PLUGIN_DIR/zsh-autosuggestions/zsh-autosuggestions.zsh"
if [[ -r "$autosuggestions_plugin" ]]; then
  source "$autosuggestions_plugin"
fi

if command -v atuin >/dev/null 2>&1 && (( ${+functions[zsh-defer]} )); then
  zsh-defer -c 'cache_eval_init atuin "atuin init zsh"'
elif command -v atuin >/dev/null 2>&1; then
  cache_eval_init atuin "atuin init zsh"
fi

unfunction source_dotfiles_file
unset autocomplete_plugin
unset autosuggestions_plugin
unset defer_plugin
unset repo_topic_files

DISABLE_UPDATE_PROMPT=true

export CC=/usr/bin/gcc

# Put local stuff that you want at the end of everything in here
if [[ -a ~/.localrc.late ]]; then
	source ~/.localrc.late
fi

# support autojump
if command -v zoxide >/dev/null 2>&1; then
	eval "$(zoxide init zsh --cmd j)"
fi

# allow zeus and unicorn to fork
export OBJC_DISABLE_INITIALIZE_FORK_SAFETY=YES

# Customize iTerm2 Touchbar integration
export TOUCHBAR_GIT_ENABLED=true
export GIT_UNCOMMITTED="+"
export GIT_UNSTAGED="!"
export GIT_UNTRACKED="?"
export GIT_STASHED="$"
export GIT_UNPULLED="⇣"
export GIT_UNPUSHED="⇡"

# Check for update of the dotfiles only when the cached marker is old enough.
if [[ "$DISABLE_AUTO_UPDATE" != "true" ]]; then
  typeset -i update_check_hours=$(( ${UPDATE_DOTFILES_DAYS:-7} * 24 ))
  if [[ ! -e $DOTFILES/cache/.dotfiles-update || -n $DOTFILES/cache/.dotfiles-update(#qN.mh+$update_check_hours) ]]; then
    env DOTFILES=$DOTFILES DISABLE_UPDATE_PROMPT=$DISABLE_UPDATE_PROMPT zsh -f $DOTFILES/tools/check_for_upgrade.sh
  fi
fi

if [[ -a $HOME/.config/yarn/global/node_modules/.bin ]]; then
	export PATH="$HOME/.config/yarn/global/node_modules/.bin:$PATH"
fi

if [[ -a $HOME/.yarn/bin ]]; then
	export PATH="$HOME/.yarn/bin:$PATH"
fi

if command -v direnv >/dev/null 2>&1; then
	cache_eval_init direnv "direnv hook zsh"
fi

if command -v starship >/dev/null 2>&1; then
  cache_eval_init starship "starship init zsh"
fi

dotfiles_maybe_remind_missing_deps() {
  emulate -L zsh

  (( ${+DOTFILES_DEPENDENCY_STATUS_FILE} )) || return 0
  [[ -r "$DOTFILES_DEPENDENCY_STATUS_FILE" ]] || return 0

  local missing_required missing_recommended dependency_id ignored_pattern
  local -a filtered_required filtered_recommended

  source "$DOTFILES_DEPENDENCY_STATUS_FILE"
  ignored_pattern=" ${DOTFILES_IGNORE_DEPS:-} "

  for dependency_id in ${(z)DOTFILES_MISSING_REQUIRED}; do
    [[ -n "$dependency_id" ]] || continue
    [[ "$ignored_pattern" == *" $dependency_id "* ]] && continue
    filtered_required+=("$dependency_id")
  done

  for dependency_id in ${(z)DOTFILES_MISSING_RECOMMENDED}; do
    [[ -n "$dependency_id" ]] || continue
    [[ "$ignored_pattern" == *" $dependency_id "* ]] && continue
    filtered_recommended+=("$dependency_id")
  done

  (( ${#filtered_required[@]} || ${#filtered_recommended[@]} )) || return 0

  if [[ -e "$DOTFILES_DEPENDENCY_REMINDER_FILE" && -z "$DOTFILES_DEPENDENCY_REMINDER_FILE"(#qN.mh+24) ]]; then
    return 0
  fi

  mkdir -p "$DOTFILES_STATE_DIR"
  : >| "$DOTFILES_DEPENDENCY_REMINDER_FILE"

  if (( ${#filtered_required[@]} )); then
    print -P "%F{yellow}[Zenjoy Dotfiles]%f Missing required dependencies: ${filtered_required[*]}"
  fi

  if (( ${#filtered_recommended[@]} )); then
    print -P "%F{yellow}[Zenjoy Dotfiles]%f Missing recommended dependencies: ${filtered_recommended[*]}"
  fi

  print -P "%F{yellow}[Zenjoy Dotfiles]%f Run 'dotfiles-doctor' for install hints."
}

# Enable GPG signing
export GPG_TTY=$(tty)

# Enable shell history in iex
export ERL_AFLAGS="-kernel shell_history enabled"

# Fig post block. Keep at the bottom of this file.
[[ -f "$HOME/.fig/shell/zshrc.post.zsh" ]] && builtin source "$HOME/.fig/shell/zshrc.post.zsh"

if command -v wtp >/dev/null 2>&1; then
  cache_eval_init wtp "wtp shell-init zsh"
fi
alias vc="echo 'entering vibe coding zone' | tte print && ${AGENT:-claude} ."
alias vce="echo 'entering vibe coding zone' | tte print && ${EDITOR:-ci} ."

if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

if command -v zsh-patina >/dev/null 2>&1; then
  if ! zsh-patina status &>/dev/null; then
    command rm -f "$HOME/.local/share/zsh-patina/daemon.sock" 2>/dev/null
    zsh-patina start &>/dev/null
    local _i=0
    while [[ ! -S "$HOME/.local/share/zsh-patina/daemon.sock" ]] && (( _i++ < 20 )); do
      sleep 0.05
    done
  fi
  eval "$(zsh-patina activate)"
fi

dotfiles_maybe_remind_missing_deps
unfunction dotfiles_maybe_remind_missing_deps

cx() { open -a "Codex" "${1:-.}"; }
c() { open -a "Zed" "${1:-.}"; }
compdef _files c
compdef _files cx

# pnpm
export PNPM_HOME="$HOME/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac
# pnpm end
