#!/usr/bin/env bash

set +e
proceed=1
result=0

DOTFILES_ROOT="$HOME/.dotfiles"
LOGFILE=/tmp/dotfiles-setup

. $DOTFILES_ROOT/script/shared-functions
. $DOTFILES_ROOT/script/dotfiles-env.sh
. $DOTFILES_ROOT/script/dotfiles-shell-stack.sh
dotfiles_init_env

# ensure we capture unexpected exits
trap exit_warning EXIT

echo "Running in $0 ${BASH_VERSION}" >> $LOGFILE

if [[ $bootstrapping -ne 1 ]]; then
  header "Let's setup our dotfiles ..."

  ask_sudo_password

  notice_left "\nFeel free to follow the details by running:"
  notice_left "${BOLD} tail -f $LOGFILE ${NORMAL}in another terminal\n"
fi

install_zsh() {
  _title_ 'Checking ZSH environment:'
  check "zsh" "command -v zsh"
  if [[ $proceed -ne 0 ]]; then
    if is_macos; then
      successfully "brew install zsh"
    elif is_linux; then
      case "$(linux_pkg_manager)" in
        apt) successfully "sudo apt-get update && sudo apt-get -y install zsh" ;;
        pacman) successfully "sudo pacman -Sy --noconfirm --needed zsh" ;;
        *) fail "zsh : unsupported distro, install zsh manually" ;;
      esac
    fi
  fi
}

install_dotfiles () {
  _title_ 'Installing dotfiles:'

  for source in `find $DOTFILES_ROOT -maxdepth 2 -name \*.symlink`
  do
    info "$source"
    link_dotfile "$source"
  done

  for source in `find $DOTFILES_ROOT/config -name \*.symlink`
  do
    info "$source"
    link_config "$source"
  done

  if [[ "`uname -s`" == "Darwin" ]]; then
    info "Fix OSX zsh environment bug"
    if [[ -f /etc/{zshenv} ]]; then
      successfully "sudo mv /etc/{zshenv,zprofile}"
    else
      success "Fix OSX zsh environment bug : not needed"
    fi
  fi
}

install_managed_plugin() {
  local plugin_repo="$1"
  local source target directory

  source="https://github.com/${plugin_repo}.git"
  directory="${plugin_repo#*/}"
  target="$DOTFILES_PLUGIN_DIR/${directory}"

  if [[ -d "$target/.git" ]]; then
    info "Updating plugin ${source} in ${target/$HOME/'~'}}"
    git -C "$target" pull --ff-only &> /dev/null
    success "plugin ${BOLD}`basename "$target"`$NORMAL : updated"
  else
    info "Cloning plugin ${source} into ${target/$HOME/'~'}}"
    git clone "$source" "$target" &> /dev/null
    success "plugin ${BOLD}`basename "$target"`$NORMAL : installed"
  fi
}

install_shell_stack() {
  local dependency_id dependency_tier dependency_type dependency_ref dependency_check dependency_hint

  _title_ 'Installing shell dependencies'
  mkdir -p "$DOTFILES_PLUGIN_DIR"

  while IFS='|' read -r dependency_id dependency_tier dependency_type dependency_ref dependency_check dependency_hint
  do
    [[ -n "$dependency_id" ]] || continue

    case "$dependency_type" in
      plugin)
        install_managed_plugin "$dependency_ref"
        ;;
      brew)
        if ! command -v brew >/dev/null 2>&1; then
          warn "$dependency_id : ${BOLD}skipped${NORMAL}, Homebrew is not available yet"
          continue
        fi

        check "$dependency_id" "$dependency_check"
        successfully "brew install $dependency_ref"
        ;;
    esac
  done < <(dotfiles_shell_stack_manifest)
}

check_os () {
  # the ubuntu subsystem on windows works a bit different
  if is_wsl; then
    touch "$DOTFILES_ROOT/.multiuser"
    export ZSH_DISABLE_COMPFIX="true"
  fi
}

install_zsh
install_dotfiles
install_shell_stack
check_os

trap finish EXIT

if [[ $bootstrapping -ne 1 ]]; then
  "$DOTFILES_ROOT/bin/dotfiles-doctor"
  _title_ "Done... Enjoy!"
fi
